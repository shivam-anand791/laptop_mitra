RewriteEngine On

# 1. Remove .php extension from URL
RewriteCond %{THE_REQUEST} \s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Handle Laptop Details URL
# domain.com/laptop/dell-latitude-7490 -> laptop-details.php?slug=dell-latitude-7490
RewriteRule ^laptop/([a-zA-Z0-9-]+)/?$ laptop-details.php?slug=$1 [L,QSA]

# 3. Internally map clean URLs to .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)$ $1.php [L]