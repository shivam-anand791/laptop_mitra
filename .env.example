# UNUSED TEMPLATE, NOT THE API CONFIG (The API uses Firebase Auth + PostgreSQL; see apps/api/.env.example)
# =============================================================================
# LaptopMitra API — environment template
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env is git-ignored. NEVER commit real credentials.
# Values starting with "changeme" are rejected at startup by design — the app
# refuses to boot on a placeholder secret rather than running insecurely.
#
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Explicit allow-list, comma separated. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000

# ---- Database ---------------------------------------------------------------
# Local dev database. Do NOT point this at the production DB.
DATABASE_URL=mysql://laptopmitra:laptopmitra@localhost:3306/laptopmitra_dev

# ---- Auth -------------------------------------------------------------------
# Must be >=32 chars and must differ from each other.
JWT_ACCESS_SECRET=changeme_generate_a_48_byte_random_secret_here
JWT_REFRESH_SECRET=changeme_generate_a_DIFFERENT_48_byte_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Payments (Razorpay) ----------------------------------------------------
# MUST be rzp_test_* sandbox keys. The app refuses to start with live keys
# unless NODE_ENV=production AND ALLOW_LIVE_PAYMENT_KEYS=true.
# Get sandbox keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme_razorpay_secret
# Set this to the same value configured in the Razorpay webhook dashboard.
RAZORPAY_WEBHOOK_SECRET=changeme_webhook_secret
ALLOW_LIVE_PAYMENT_KEYS=false

# ---- Mail -------------------------------------------------------------------
# 'console' logs emails instead of sending them. Keep this for development —
# 'smtp' outside production requires ALLOW_REAL_EMAILS=true.
MAIL_DRIVER=console
MAIL_FROM=no-reply@laptopmitra.com
ALLOW_REAL_EMAILS=false

# Only needed when MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# ---- File storage -----------------------------------------------------------
# cloudinary | s3 | local   ('local' is dev-only, rejected in production)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=laptopmitra

# Only needed when STORAGE_DRIVER=s3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

UPLOAD_MAX_BYTES=5242880

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
