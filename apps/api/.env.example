# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public"

# Firebase Admin
# FIREBASE_SERVICE_ACCOUNT_PATH is for local development only.
# Production must use FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Firebase Admin (production deployment)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CHECK_REVOKED=false

# Application
PORT=3001
NODE_ENV="development"
ENABLE_SWAGGER=false
# CORS_ORIGINS: Comma-separated list of allowed web origins (Required in production)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://laptop-mitra.vercel.app,https://laptopmitra.com"

# Razorpay (Test keys - NEVER use production keys in development)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"

# In-memory fallback (development-only; NEVER active in production)
ALLOW_IN_MEMORY_FALLBACK=false

# Security & Sensitive Financial Data Encryption
# 32-byte (256-bit) hex key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_ENCRYPTION_KEY="replace-with-64-character-hex-string"

# Mail (Resend / SMTP / Console)
MAIL_DRIVER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxx"
MAIL_FROM="onboarding@resend.dev"
ALLOW_REAL_EMAILS=true

