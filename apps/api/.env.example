# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public"

# Firebase Admin (local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Firebase Admin (production deployment alternative)
# FIREBASE_PROJECT_ID=laptop-mitra
# FIREBASE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CHECK_REVOKED=true

# Application
PORT=3001
NODE_ENV="development"
# CORS_ORIGINS: Comma-separated list of allowed web origins (Required in production)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://laptopmitra.com"

# Razorpay (Test keys - NEVER use production keys in development)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM="noreply@laptopmitra.com"
