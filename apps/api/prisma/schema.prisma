model OrderChangeRequest {
  id            String    @id @default(uuid())
  requestNumber String    @unique
  orderId       String
  orderItemId   String?
  userId        String
  ticketId      String?
  type          String // ADDRESS_CHANGE | PHONE_CHANGE | LEASE_EXTENSION | LEASE_TERMINATION | LEASE_BUYOUT
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | APPLIED
  requestedData Json
  previousData  Json
  adminNotes    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([userId, status])
  @@index([status, createdAt])
}

model BusinessProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  companyName     String
  gstin           String
  billingAddress  Json
  contactPerson   String
  contactPhone    String
  contactEmail    String
  priorityEnabled Boolean  @default(true)
  accountManager  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([priorityEnabled])
  @@index([gstin])
}

model ClientNote {
  id         String   @id @default(uuid())
  userId     String
  authorId   String
  authorName String
  authorRole String
  note       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model BuybackTier {
  id            String   @id @default(uuid())
  fromMonths    Int
  toMonths      Int
  percentage    Decimal  @db.Decimal(5, 2)
  effectiveDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requests BuybackRequest[]

  @@unique([fromMonths, toMonths, effectiveDate])
  @@index([isActive, fromMonths])
}

model BuybackSettings {
  id                String   @id @default("singleton")
  quoteValidityDays Int      @default(15)
  convenienceCharge Decimal  @default(0.00) @db.Decimal(10, 2)
  batteryMinPercent Int      @default(70)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

model BuybackRequest {
  id            String  @id @default(uuid())
  requestNumber String  @unique
  orderId       String
  orderItemId   String
  unitNumber    Int     @default(1)
  userId        String
  ticketId      String? @unique
  tierId        String

  originalNetPrice    Decimal  @db.Decimal(10, 2)
  deviceAgeMonths     Int
  tierPercentApplied  Decimal  @db.Decimal(5, 2)
  convenienceCharge   Decimal  @db.Decimal(10, 2)
  initialQuotedAmount Decimal  @db.Decimal(10, 2)
  revisedQuotedAmount Decimal? @db.Decimal(10, 2)
  finalPayoutAmount   Decimal? @db.Decimal(10, 2)

  status             String    @default("REQUESTED")
  quoteVersion       Int       @default(1)
  quoteIssuedAt      DateTime?
  quoteExpiresAt     DateTime?
  quoteAcceptedAt    DateTime?
  customerAcceptedAt DateTime?

  bootsToOs            Boolean?
  motherboardWorking   Boolean?
  displayIntact        Boolean?
  originalCharger      Boolean?
  batteryHealthPercent Int?
  inspectionNotes      String?
  inspectedBy          String?
  inspectedAt          DateTime?

  payoutKeyId            String?
  payoutEncryptedData    String?
  payoutMaskedAccount    String?
  payoutMaskedIfsc       String?
  payoutMaskedUpi        String?
  payoutDetailsUpdatedAt DateTime?
  payoutUtr              String?
  payoutProcessedAt      DateTime?

  returnCourierName    String?
  returnTrackingNumber String?
  returnDispatchedAt   DateTime?
  returnDeliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  ticket      SupportTicket?     @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  tier        BuybackTier        @relation(fields: [tierId], references: [id], onDelete: Restrict)
  events      BuybackEvent[]
  attachments TicketAttachment[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model BuybackEvent {
  id        String   @id @default(uuid())
  requestId String
  actorId   String
  actorRole String
  eventType String
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())

  request BuybackRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model OrderItemCancellation {
  id                String    @id @default(uuid())
  orderItemId       String
  orderId           String
  cancelledBy       String
  reason            String
  refundAmount      Decimal   @default(0) @db.Decimal(10, 2)
  refundStatus      String    @default("NOT_APPLICABLE")
  restockedQuantity Int       @default(0)
  createdAt         DateTime  @default(now())

  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([orderId])
  @@index([createdAt])
}

model LeaseContract {
  id                   String              @id @default(uuid())
  contractNumber       String              @unique
  orderId              String
  orderItemId          String              @unique
  userId               String
  productId            String
  tenureMonths         Int
  monthlyAmount        Decimal             @db.Decimal(10, 2)
  totalCommitment      Decimal             @db.Decimal(10, 2)
  startDate            DateTime
  endDate              DateTime
  status               String              @default("ACTIVE")
  rentalSubscriptionId String?             @unique
  buyoutQuoteAmount    Decimal?            @db.Decimal(10, 2)
  buyoutQuoteExpiresAt DateTime?
  buyoutStatus         String?             @default("NONE")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  order                Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem            OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  product              Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  rentalSubscription   RentalSubscription? @relation(fields: [rentalSubscriptionId], references: [id], onDelete: Restrict)
  installments         LeaseInstallment[]
  events               LeaseEvent[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model LeaseInstallment {
  id                String        @id @default(uuid())
  leaseContractId   String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal       @db.Decimal(10, 2)
  status            String        @default("PENDING")
  paidAt            DateTime?
  paymentId         String?
  gatewayPaymentId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  contract          LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Restrict)

  @@unique([leaseContractId, installmentNumber])
  @@index([leaseContractId, status])
  @@index([dueDate])
}

model LeaseEvent {
  id              String        @id @default(uuid())
  leaseContractId String
  actorId         String
  actorRole       String
  eventType       String
  eventData       Json?
  createdAt       DateTime      @default(now())

  contract        LeaseContract @relation(fields: [leaseContractId], references: [id], onDelete: Restrict)

  @@index([leaseContractId, createdAt])
}

// ---------------------------------------------------------------------------
// Free Service, Serial Tracking & Warranty Register Models (Stage 1 Approved)
// ---------------------------------------------------------------------------

model SoldUnit {
  id              String    @id @default(uuid())
  orderItemId     String
  productId       String
  userId          String
  unitIndex       Int       @default(1)
  serialNumber    String?
  brandSnapshot   String
  modelSnapshot   String
  status          String    @default("ACTIVE") // ACTIVE | RETURNED | REFUNDED | BOUGHT_BACK | REPLACED
  isDispatched    Boolean   @default(false)
  dispatchedAt    DateTime?
  dispatchedBy    String?
  overrideReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orderItem        OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  serialHistory    SoldUnitSerialHistory[]
  warrantyCoverage WarrantyCoverage?
  entitlements     ServiceEntitlement[]
  serviceJobs      ServiceJob[]

  @@unique([orderItemId, unitIndex])
  @@index([serialNumber])
  @@index([userId, status])
  @@index([productId])
}

model SoldUnitSerialHistory {
  id             String   @id @default(uuid())
  soldUnitId     String
  previousSerial String?
  newSerial      String
  changedBy      String
  reason         String
  createdAt      DateTime @default(now())

  soldUnit SoldUnit @relation(fields: [soldUnitId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([soldUnitId, createdAt])
}

model WarrantyCoverage {
  id             String   @id @default(uuid())
  soldUnitId     String   @unique
  source         String   @default("BASE") // BASE | EXTENDED
  monthsSnapshot Int      @default(6)
  startDate      DateTime
  endDate        DateTime
  status         String   @default("ACTIVE") // ACTIVE | EXPIRED | VOIDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  soldUnit SoldUnit @relation(fields: [soldUnitId], references: [id], onDelete: Restrict)

  @@index([endDate, status])
}

model ServiceEntitlement {
  id          String    @id @default(uuid())
  soldUnitId  String
  userId      String
  kind        String    @default("OUTRIGHT_FREE") // OUTRIGHT_FREE | LEASE_MONTHLY
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("AVAILABLE") // AVAILABLE | BOOKED | USED | EXPIRED | CANCELLED
  cycleMonth  Int?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  soldUnit   SoldUnit    @relation(fields: [soldUnitId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  serviceJob ServiceJob?

  @@index([soldUnitId, status])
  @@index([userId, status])
  @@index([periodEnd, status])
}

model ServiceJob {
  id                    String    @id @default(uuid())
  jobNumber             String    @unique
  soldUnitId            String
  entitlementId         String    @unique
  userId                String
  technicianId          String?
  status                String    @default("REQUESTED")
  pickupAddress         Json
  pickupPincode         String
  preferredSlot         String
  scheduledPickupAt     DateTime?
  actualPickedUpAt      DateTime?
  scheduledDropAt       DateTime?
  actualDeliveredAt     DateTime?
  checklistCleaning     Boolean   @default(false)
  checklistThermalPaste Boolean   @default(false)
  checklistSoftware     Boolean   @default(false)
  checklistBattery      Boolean   @default(false)
  batteryHealthPercent  Int?
  partsReplaced         String?
  internalNotes         String?
  customerNotes         String?
  internalPhotos        Json?
  backupAcknowledged    Boolean   @default(true)
  receiptNumber         String?   @unique
  receiptPdfKey         String?
  cancellationReason    String?
  cancelledBy           String?
  rescheduledCount      Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  soldUnit    SoldUnit           @relation(fields: [soldUnitId], references: [id], onDelete: Restrict)
  entitlement ServiceEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  customer    User               @relation("ServiceCustomer", fields: [userId], references: [id], onDelete: Restrict)
  technician  User?              @relation("AssignedTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  events      ServiceEvent[]

  @@index([status, createdAt])
  @@index([technicianId, status])
  @@index([userId, status])
  @@index([soldUnitId])
}

model ServiceEvent {
  id        String   @id @default(uuid())
  jobId     String
  actorId   String
  actorRole String
  eventType String
  oldStatus String?
  newStatus String?
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())

  job   ServiceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  actor User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
}

model ServiceSettings {
  id                        String   @id @default("default")
  includedWork              Json
  windowMonthsOutright      Int      @default(6)
  leaseCadenceMonths        Int      @default(1)
  serviceAreaPincodes       Json
  slotWindows               Json
  serviceTermsText          String   @db.Text
  dataBackupDisclaimerText  String   @db.Text
  reminderLeadDays          Json
  warrantyReminderLeadDays  Int      @default(30)
  freeServiceEnabledDefault Boolean  @default(true)
  updatedById               String?
  updatedAt                 DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
}

model NotificationDedupeLog {
  id          String   @id @default(uuid())
  channel     String
  recipient   String
  templateKey String
  dedupeKey   String
  sentAt      DateTime @default(now())
  metadata    Json?

  @@unique([templateKey, dedupeKey])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// OTP Verification & Password Reset Challenge Ledger (Option A)
// ---------------------------------------------------------------------------

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model OtpChallenge {
  id             String      @id @default(uuid())
  userId         String?
  email          String
  codeHash       String
  purpose        OtpPurpose
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  expiresAt      DateTime
  isConsumed     Boolean     @default(false)
  consumedAt     DateTime?
  grantTokenHash String?
  grantExpiresAt DateTime?
  ipAddress      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, isConsumed, expiresAt])
  @@index([userId, purpose])
  @@index([grantTokenHash])
}
