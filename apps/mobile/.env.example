# Public Firebase client configuration copied from the intended Firebase project.
# These values identify the app; do not put Admin SDK credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-mobile-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-mobile-app-id

# Optional; otherwise the app derives a local development URL.
EXPO_PUBLIC_API_URL=http://localhost:3001
