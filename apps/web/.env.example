# ==============================================================================
# LaptopMitra Web Environment Variables (Next.js)
# ==============================================================================
# IMPORTANT: All NEXT_PUBLIC_* variables are baked into client-side JavaScript bundles
# at BUILD TIME. If you update any of these variables in Vercel or your hosting
# provider, you MUST trigger a new deployment/rebuild for changes to take effect.
# In production builds (NODE_ENV=production), missing variables will cause the build to fail.
# ==============================================================================

# Backend API URL (must start with https:// and have no trailing slash in production)
# In local development, defaults to http://localhost:3001 if omitted.
NEXT_PUBLIC_API_URL=https://api.laptopmitra.com

# Razorpay Key ID
# Use rzp_test_ keys until payments are fully tested. The key id must belong to the same Razorpay account and mode as RAZORPAY_KEY_ID/SECRET on the API.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id

# Firebase Web Client Configuration (from Firebase Console > Project Settings > General > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_replace_with_your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Allowed Image Hostnames for next/image (comma-separated list)
# Defaults to: images.unsplash.com, via.placeholder.com
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com,via.placeholder.com

# ==============================================================================
# DEVELOPMENT ONLY - Firebase Auth Emulator
# The settings below are for local development ONLY.
# Emulator use is strictly disabled in production builds even if these are set.
# ==============================================================================
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
