# ==============================================================================
# LaptopMitra Web Client Environment Variables (Next.js)
# ==============================================================================
# Safe public configuration for the browser (prefixed with NEXT_PUBLIC_).
# NEVER put server secrets, database credentials, or private keys here.
# ==============================================================================

# Backend API URL (Production Render URL or local development http://localhost:3001)
NEXT_PUBLIC_API_URL=https://laptopmitra-api.onrender.com

# Razorpay Publishable Key (Client-safe)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Firebase Web Client Configuration (Project: laptop-mitra)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyPlaceholderWebApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=laptop-mitra.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=laptop-mitra
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=laptop-mitra.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=101564514748
NEXT_PUBLIC_FIREBASE_APP_ID=1:101564514748:web:placeholder

# Allowed Image Hostnames for next/image
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com,via.placeholder.com
